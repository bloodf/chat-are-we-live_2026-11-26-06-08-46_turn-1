{
  "name": "chat-are-we-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.1",
    "gltfpack": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "description": "Chat, Are We Live? A 3D live-streamer life simulation.",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run build && npm run test:e2e",
    "backup": "node scripts/backup.mjs",
    "forge:assets": "bash forge/run_all.sh"
  }
}
